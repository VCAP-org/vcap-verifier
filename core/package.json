{
  "name": "vcap-verify-core",
  "version": "0.1.0",
  "description": "vcap proof verification, isomorphic: the same verdict in a browser, in Node, in the platform. WebCrypto only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vectors:sync": "node vectors-sync.mjs",
    "vectors:check": "node vectors-sync.mjs --check"
  },
  "devDependencies": {
    "@peculiar/x509": "^2.1.0",
    "@types/node": "^22.10.5",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "asn1js": "^3.0.10",
    "cbor-x": "^1.6.6"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
